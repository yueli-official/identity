# Copy to .env and replace every value marked REQUIRED before deployment.
# Generate secrets with a password manager or: openssl rand -base64 48
IDENTITY_GLOBAL_SECRET=REQUIRED-at-least-32-random-bytes
IDENTITY_POSTGRES_PASSWORD=REQUIRED-random-database-password

# Public origins.
IDENTITY_ISSUER=http://localhost:8081
IDENTITY_ACCOUNT_ORIGIN=http://localhost:3000
IDENTITY_PORT=8081
IDENTITY_ACCOUNT_PORT=3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEBAUTHN_RPID=localhost
IDENTITY_WEBAUTHN_ORIGINS=["http://localhost:3000"]

# Standalone defaults. Point these at existing infrastructure to reuse it.
IDENTITY_DATABASE_HOST=identity-postgres
IDENTITY_DATABASE_PORT=5432
IDENTITY_DATABASE_USER=postgres
IDENTITY_DATABASE_NAME=identity
IDENTITY_DATABASE_SSLMODE=disable
IDENTITY_REDIS_ADDRESS=identity-redis:6379
IDENTITY_REDIS_PASSWORD=

# golang-migrate connection string. Keep it aligned with the fields above.
IDENTITY_DATABASE_URL=postgres://postgres:REQUIRED-random-database-password@identity-postgres:5432/identity?sslmode=disable

# Optional published image names/tags.
IDENTITY_IMAGE=yueli/identity:local
IDENTITY_ACCOUNT_IMAGE=yueli/identity-account:local
